msgid "Lawhaa Shipping Rules requires WooCommerce to be active."
msgstr "تتطلب إضافة قواعد شحن لوحة تفعيل WooCommerce."

msgid "Shipping settings"
msgstr "إعدادات الشحن"

msgid "Updating shipping options..."
msgstr "جاري تحديث خيارات الشحن..."

msgid "Lawhaa Smart Shipping"
msgstr "شحن لوحة الذكي"

msgid "Calculates Lawhaa local, fast, carrier, pickup, and heavy sink shipping from city, district, cart value, and weight."
msgstr "تحسب شحن لوحة المحلي والسريع وشركات الشحن والاستلام وشحن الأحواض حسب المدينة والحي وقيمة السلة والوزن."

msgid "Enable/Disable"
msgstr "تفعيل/تعطيل"

msgid "Enable Lawhaa smart shipping for this shipping zone"
msgstr "تفعيل شحن لوحة الذكي في منطقة الشحن هذه"

msgid "Method group title"
msgstr "عنوان مجموعة طريقة الشحن"

msgid "Internal title for the shipping-zone method. Customer-facing rate titles are generated by the rules."
msgstr "عنوان داخلي لطريقة الشحن داخل منطقة الشحن. العناوين التي تظهر للعميل تُولّد من القواعد."

msgid "Lawhaa Shipping"
msgstr "شحن لوحة"

msgid "Debug mode"
msgstr "وضع التصحيح"

msgid "Add rule context as shipping-rate metadata for testing"
msgstr "إضافة سياق القاعدة كبيانات إضافية على سعر الشحن للاختبار"

msgid "Lawhaa group"
msgstr "مجموعة شحن لوحة"

msgid "Destination city"
msgstr "مدينة الوجهة"

msgid "Destination area"
msgstr "منطقة الوجهة"

msgid "Package weight"
msgstr "وزن الشحنة"

msgid "Package amount"
msgstr "قيمة الشحنة"

msgid "Heavy sink shipping (1-5 business days)"
msgstr "شحن الأحواض (1-5 أيام عمل)"

msgid "Delivery time"
msgstr "مدة التوصيل"

msgid "1-5 business days"
msgstr "1-5 أيام عمل"

msgid "Rule"
msgstr "القاعدة"

msgid "Orders above 150 kg"
msgstr "الطلبات فوق 150 كجم"

msgid "Center delivery - free (24-48 hours)"
msgstr "شحن المركز - مجاني (24-48 ساعة)"

msgid "Center delivery (24-48 hours)"
msgstr "شحن المركز (24-48 ساعة)"

msgid "24-48 hours"
msgstr "24-48 ساعة"

msgid "COD fee"
msgstr "رسوم الدفع عند الاستلام"

msgid "No COD fee"
msgstr "بدون رسوم دفع عند الاستلام"

msgid "Fast shipping - Mrsool (2-4 hours)"
msgstr "شحن سريع - مرسول (2-4 ساعات)"

msgid "2-4 hours"
msgstr "2-4 ساعات"

msgid "Maximum weight"
msgstr "الوزن الأقصى"

msgid "50 kg"
msgstr "50 كجم"

msgid "Fast shipping - C4D (2-4 hours)"
msgstr "شحن سريع - C4D (2-4 ساعات)"

msgid "Pickup from center - free"
msgstr "استلام من المركز - مجاني"

msgid "Pickup"
msgstr "استلام"

msgid "Available for nearby areas"
msgstr "متاح للمناطق القريبة"

msgid "Carrier shipping - free (1-5 business days)"
msgstr "شحن شركات الشحن - مجاني (1-5 أيام عمل)"

msgid "Carrier shipping (1-5 business days)"
msgstr "شحن شركات الشحن (1-5 أيام عمل)"

msgid "15 SAR if COD is selected"
msgstr "15 ريال في حال اختيار الدفع عند الاستلام"

msgid "Cash on delivery fee"
msgstr "رسوم الدفع عند الاستلام"

msgid "Please enter or validate the National Address so the city can be used to calculate shipping."
msgstr "يرجى إدخال أو التحقق من العنوان الوطني حتى يمكن استخدام المدينة لحساب الشحن."
